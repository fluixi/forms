{
  "name": "@fluixi/forms",
  "version": "1.0.0-alpha.113",
  "license": "MIT",
  "description": "Reactive forms for Fluixi: re-exports every @fluixi/forms-* package (core, framework, zod, valibot, devtools).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./framework": {
      "types": "./dist/framework.d.ts",
      "import": "./dist/framework.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./valibot": {
      "types": "./dist/valibot.d.ts",
      "import": "./dist/valibot.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "README.md",
    "llms.txt",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fluixi/forms-core": "workspace:*",
    "@fluixi/forms-framework": "workspace:*",
    "@fluixi/forms-zod": "workspace:*",
    "@fluixi/forms-valibot": "workspace:*",
    "@fluixi/forms-devtools": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluixi/forms.git",
    "directory": "packages/forms"
  }
}
